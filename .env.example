# ── サーバー設定 ──────────────────────────────────────
PORT=8080
GIN_MODE=debug   # 本番では release に変更

# ── JWT ───────────────────────────────────────────────
# openssl rand -hex 32 で生成した値を設定
JWT_SECRET=your-super-secret-key-change-this

# ── PostgreSQL ────────────────────────────────────────
# ローカル: docker-compose の設定に合わせる
# AWS   : DATABASE_URL に RDS のエンドポイントを直接設定
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=game_score

# AWS RDS を使う場合はこちらを設定（上の DB_* より優先）
# DATABASE_URL=postgres://user:pass@rds-endpoint:5432/game_score

# ── Redis ─────────────────────────────────────────────
# ローカル: docker-compose の設定
# AWS   : ElastiCache のエンドポイントを設定
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── ランキングキャッシュ設定 ───────────────────────────
RANKING_CACHE_TTL=60   # キャッシュ有効期間（秒）
RANKING_LIMIT=100      # ランキング表示件数
